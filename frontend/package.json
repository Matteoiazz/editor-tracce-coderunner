{
  "name": "tesi-frontend",
  "private": true,
  "type": "module",
  "version": "1.1.1",
  "description": "Interfaccia Electron per la preparazione di tracce d'esame CodeRunner",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "electron": "electron .",
    "test": "vitest run",
    "prepara-python": "node scripts/prepara-python.cjs",
    "installer": "npm run build && electron-builder --publish never"
  },
  "devDependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@tiptap/extension-table": "^3.31.3",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.4.3",
    "electron-builder": "26.15.3",
    "monaco-editor": "^0.56.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "author": "Matteo Iazzolino",
  "license": "MIT",
  "homepage": "https://github.com/Matteoiazz/editor-tracce-coderunner",
  "desktopName": "editor-tracce-coderunner.desktop",
  "build": {
    "appId": "it.unical.editor-tracce-coderunner",
    "productName": "Editor tracce CodeRunner",
    "executableName": "editor-tracce-coderunner",
    "electronLanguages": [
      "it",
      "en-US"
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "electron/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "python-runtime",
        "to": "python",
        "filter": [
          "**/*",
          "!**/__pycache__/**"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Editor tracce CodeRunner",
      "installerLanguages": [
        "it_IT"
      ],
      "language": "1040",
      "deleteAppDataOnUninstall": false,
      "artifactName": "Editor-tracce-CodeRunner-Setup-${version}.${ext}"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.education",
      "identity": "-",
      "hardenedRuntime": false,
      "artifactName": "Editor-tracce-CodeRunner-${version}-${arch}.${ext}"
    },
    "dmg": {
      "title": "Editor tracce CodeRunner"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "build/icon.png",
      "category": "Education",
      "synopsis": "Preparazione di tracce d'esame CodeRunner per Moodle",
      "maintainer": "Matteo Iazzolino <Matteoiazz@users.noreply.github.com>",
      "artifactName": "Editor-tracce-CodeRunner-${version}-${arch}.${ext}",
      "syncDesktopName": true
    }
  }
}
