    <answer><![CDATA[def dominante(n, lst):
    return lst.count(n) > n/2

def somma(lst):
    speciali = []
    for i in lst:
        if i not in speciali and dominante(i, lst):
            speciali.append(i)
    return sum(speciali)

if __name__ == "__main__":
    import sys
    import random
    seed = int(input())
    random.seed(seed)
    n = int(input())
    lst = []
    for i in range(n):
        myrand = random.randint(1, 10)
        if myrand % 2 != 0:
            myrand += 1
        lst.append(myrand)
    print(f"Input: {lst} - Risultato: {somma(lst.copy())}")]]></answer>
