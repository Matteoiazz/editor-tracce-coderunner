    <answer><![CDATA[def calcola(lst):
    movimento = 0
    visitati = []
    
    while True:
        if movimento in visitati:
            break
        visitati.append(movimento)
        if lst[movimento] % 2 == 0:
            movimento = (movimento - 1) % len(lst)
        else:
            movimento = (movimento + lst[movimento]) % len(lst)
        
    return sum([lst[i] for i in visitati])
    
   
if __name__ == "__main__":
    import random
    seed = int(input())
    random.seed(seed)
    n = int(input()) * 2
    if n < 0:
        n = -n
        value = n*4
    else:
        value = n+2
    n+=2
    lst = []
    for i in range(n):
        numero = random.randint(1,value)
        while numero in lst:
            numero = random.randint(1,value*10)
        lst.append(numero)

    print(f"Input: {lst} - Risultato: {calcola(lst)}")]]></answer>
